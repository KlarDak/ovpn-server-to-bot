# Путь до директории сервера OpenVPN
OVPN_SERVER=
# Публичный IPv4-адрес или домен OpenVPN-сервера (необязательно).
# Если значение не задано, ovpn-ctrl.sh автоматически определит внешний IPv4.
OVPN_PUBLIC_HOST=
# Путь до директории сервера-обработчика запросов
SERVER=
# Путь до директории хранения .ovpn-файлов
CONFIGS_DIR=
# Путь до директории хранения SQLite базы данных
USERDB_DIR=
# Путь до директории хранения файла-шаблона генерации .ovpn-конфигов
TEMP_FILE=
